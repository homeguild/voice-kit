# @homeguild is a private scope served from GitHub Packages. The auth token is
# NEVER committed — it's read from the environment (NODE_AUTH_TOKEN) at publish
# and install time. Locally: `export NODE_AUTH_TOKEN=<gh PAT with read/write:packages>`.
# In CI (Jenkins): inject the token as NODE_AUTH_TOKEN. See PUBLISHING.md.
@homeguild:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
