{
  "name": "@homeguild/conversation-kit",
  "version": "0.1.6",
  "description": "The conversation surface — React port. One protocol, two ports (Flutter + React), proven equal by shared fixtures. Proprietary.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeguild/voice-kit.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "tsx visual/generate.ts && playwright test",
    "test:visual:update": "tsx visual/generate.ts && playwright test --update-snapshots",
    "gen:cassettes": "node scripts/gen-cassettes.mjs",
    "gen:personas": "node scripts/gen-personas.mjs",
    "gen:fixtures": "npm run gen:cassettes && npm run gen:personas",
    "prepublishOnly": "npm run gen:fixtures && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
