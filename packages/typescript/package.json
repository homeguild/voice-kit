{
  "name": "@homeguild/conversation-kit",
  "version": "0.1.0",
  "description": "The conversation surface — React port. One protocol, two ports (Flutter + React), proven equal by shared fixtures. Proprietary.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "tsx visual/generate.ts && playwright test",
    "test:visual:update": "tsx visual/generate.ts && playwright test --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
